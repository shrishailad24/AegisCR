# AAROHA OS Backend Environment Configuration Template
# Copy this file to a new file named '.env' and fill in your actual private keys.
# NEVER commit the actual '.env' file to Git tracking.

# Groq Cloud API Key
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenAI API Key (if using GPT models instead of Llama-3.3 on Groq)
OPENAI_API_KEY=your_openai_api_key_here
